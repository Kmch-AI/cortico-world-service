{
  "name": "@kmchai/cortico-world-service",
  "version": "0.4.0",
  "type": "module",
  "description": "Cortico World: host local inference services and expose them through one OpenAI-shaped speech API; audiocpp is only one backend",
  "author": "kmchai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kmch-AI/cortico-world-service.git"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "audiocpp",
    "tts",
    "speech",
    "语音",
    "语音合成",
    "语音服务",
    "进程托管"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Kmch AI · 服务",
    "locales": {
      "zh": {
        "displayName": "Kmch AI · 服务",
        "description": "托管本机推理服务,统一暴露 OpenAI 形状的语音接口;audiocpp 只是其中一种后端。"
      },
      "en": {
        "displayName": "Kmch AI · Service",
        "description": "Host local inference services behind one OpenAI-shaped speech API; audiocpp is only one backend."
      }
    },
    "tags": [
      "voice",
      "local",
      "external-setup",
      "experimental"
    ],
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist/webui.js",
    "dist/webui.css",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json",
    "build:webui": "node scripts/build-webui.mjs",
    "smoke:webui": "node scripts/smoke-webui.mjs",
    "smoke:host": "tsx scripts/smoke-host.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "jsdom": "30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
