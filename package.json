{
  "name": "@kmchai/cortico-world-audiocpp",
  "version": "0.1.1",
  "type": "module",
  "description": "Cortico World: host and supervise a local audiocpp_server (start, health, restart, status) for other voice Worlds",
  "author": "kmchai",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "audiocpp",
    "tts",
    "speech",
    "语音",
    "语音合成",
    "语音服务",
    "进程托管"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "audiocpp",
    "locales": {
      "zh": {
        "displayName": "audiocpp 服务",
        "description": "拉起并看守本机 audiocpp_server:探活、状态、日志与退出重启,供语音 World 通过 HTTP 使用。"
      },
      "en": {
        "displayName": "audiocpp",
        "description": "Host and supervise a local audiocpp_server: health, status, logs and restart, for voice Worlds over HTTP."
      }
    },
    "tags": [
      "local",
      "external-setup",
      "experimental"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "describe.json"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke:host": "tsx scripts/smoke-host.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
